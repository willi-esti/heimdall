# PostgreSQL Configuration for Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=heimdall

# Database Connection
DATABASE_URL="postgresql://postgres:postgres@heimdall_postgres:5432/heimdall?schema=public"

# JWT Authentication
JWT_SECRET="your-super-secure-jwt-secret-key-at-least-32-characters-long"
JWT_EXPIRES_IN="7d"

# Server Configuration
HOST="localhost"  # Change to your server's IP address if needed
PORT=3000
NODE_ENV="development"  # Set to "production" to disable Swagger documentation

# CORS Configuration
# Comma-separated list of allowed origins for production
# Example: CORS_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"
CORS_ORIGINS=""

# Logging Configuration
LOG_LEVEL="info"
LOG_MAX_SIZE="20m"
LOG_MAX_FILES="30d"
LOG_ERROR_MAX_FILES="14d"
LOG_COMPRESSION="true"

# Encryption for secrets
ENCRYPTION_KEY="your-32-character-encryption-key-for-aes-256!!"
