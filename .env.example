# Environment variables for Heimdall Secrets Management
# Copy this file to server/.env and update the values as needed

# Database Configuration
DATABASE_URL=postgresql://heimdall_user:heimdall_password@postgres:5432/heimdall?schema=public

# JWT Configuration  
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-make-it-long-and-random
JWT_EXPIRES_IN=7d

# Encryption Configuration (must be exactly 32 characters)
ENCRYPTION_KEY=abcdefghijklmnopqrstuvwxyz123456

# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Security Headers
CORS_ORIGIN=http://localhost:3000
