// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String   // hashed password
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  memberships Membership[]
  auditLogs   AuditLog[]

  @@map("users")
}

// Organization model
model Organization {
  id          String   @id @default(cuid())
  name        String
  description String?
  
  // Soft deletion fields
  isDeleted             Boolean   @default(false)
  deletionRequestedAt   DateTime?
  deletionRequestedBy   String?
  deletionApprovedAt    DateTime?
  deletionApprovedBy    String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  memberships Membership[]
  folders     Folder[]
  deletionRequests OrganizationDeletionRequest[]
  invites     OrganizationInvite[]

  @@map("organizations")
}

// Membership model - links users to organizations with rights
model Membership {
  id    String @id @default(cuid())
  role  Role   @default(VIEW)
  
  // Foreign keys
  userId         String
  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

// Folder model - can be nested, stores secrets
model Folder {
  id          String  @id @default(cuid())
  name        String
  description String?
  parentId    String? // nullable for root folders
  
  // Foreign keys
  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Folder?      @relation("FolderHierarchy", fields: [parentId], references: [id])
  children     Folder[]     @relation("FolderHierarchy")
  secrets      Secret[]

  @@map("folders")
}

// Secret model - encrypted secrets stored in folders
model Secret {
  id           String @id @default(cuid())
  name         String
  description  String?
  encryptedValue String // AES-256-GCM encrypted
  type         SecretType @default(GENERIC)
  
  // Foreign keys
  folderId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  folder   Folder          @relation(fields: [folderId], references: [id], onDelete: Cascade)
  versions SecretVersion[]
  auditLogs AuditLog[]

  @@map("secrets")
}

// SecretVersion model - keeps history of secret changes
model SecretVersion {
  id             String @id @default(cuid())
  encryptedValue String // AES-256-GCM encrypted
  version        Int    @default(1)
  changeNote     String?
  
  // Foreign keys
  secretId String
  createdBy String

  createdAt DateTime @default(now())

  // Relations
  secret Secret @relation(fields: [secretId], references: [id], onDelete: Cascade)

  @@map("secret_versions")
}

// AuditLog model - tracks all access and changes
model AuditLog {
  id       String    @id @default(cuid())
  action   AuditAction
  details  String?   // JSON string with additional details
  ipAddress String?
  userAgent String?
  
  // Foreign keys
  userId   String
  secretId String?  // nullable for non-secret actions

  createdAt DateTime @default(now())

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret Secret? @relation(fields: [secretId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// OrganizationDeletionRequest model - tracks deletion requests with metadata
model OrganizationDeletionRequest {
  id          String   @id @default(cuid())
  reason      String?  // Optional reason for deletion
  status      DeletionStatus @default(PENDING)
  
  // Foreign keys
  organizationId String
  requestedBy    String  // User who requested deletion
  approvedBy     String? // User who approved deletion (nullable)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  approvedAt  DateTime? // When deletion was approved
  
  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@map("organization_deletion_requests")
}

// OrganizationInvite model - tracks organization invitations
model OrganizationInvite {
  id          String   @id @default(cuid())
  email       String   // Email address of the invited user
  role        Role     @default(VIEW) // Role to assign when invite is accepted
  token       String   @unique // Unique token for the invite link
  status      InviteStatus @default(PENDING)
  
  // Foreign keys
  organizationId String
  invitedBy      String  // User who sent the invitation
  acceptedBy     String? // User who accepted the invitation (nullable)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expiresAt   DateTime // When the invite expires
  acceptedAt  DateTime? // When invite was accepted
  
  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@map("organization_invites")
}

// Enums
enum Role {
  VIEW
  WRITE
  ADMIN
}

enum DeletionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SecretType {
  GENERIC
  PASSWORD
  API_KEY
  TOKEN
  CERTIFICATE
  DATABASE_URL
}

enum AuditAction {
  SECRET_CREATED
  SECRET_VIEWED
  SECRET_UPDATED
  SECRET_DELETED
  FOLDER_CREATED
  FOLDER_UPDATED
  FOLDER_DELETED
  USER_INVITED
  USER_INVITE_ACCEPTED
  USER_INVITE_REJECTED
  USER_REMOVED
  ROLE_CHANGED
  ORGANIZATION_DELETION_REQUESTED
  ORGANIZATION_DELETION_APPROVED
  ORGANIZATION_DELETION_REJECTED
  ORGANIZATION_DELETED
}
